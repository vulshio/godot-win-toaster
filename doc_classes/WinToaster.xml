<?xml version="1.0" encoding="UTF-8" ?>
<class name="WinToaster" inherits="RefCounted" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
	<brief_description>
		Shows Windows toast notifications.
	</brief_description>
	<description>
		Thin wrapper around the vendored WinToast library. Call [method initialize] once, then use [method show_toast] to display notifications.
	</description>
	<tutorials>
	</tutorials>
	<methods>
		<method name="clear">
			<return type="void" />
			<description>
				Hides all currently displayed toasts.
			</description>
		</method>
		<method name="hide_toast">
			<return type="bool" />
			<param index="0" name="toast_id" type="int" />
			<description>
				Hides the toast with the given id. Returns [code]true[/code] on success.
			</description>
		</method>
		<method name="initialize">
			<return type="bool" />
			<param index="0" name="app_name" type="String" />
			<param index="1" name="app_id" type="String" />
			<param index="2" name="create_shortcut" type="bool" default="true" />
			<description>
				Initializes WinToast. [param app_name] is the name shown in the notification, and [param app_id] is the AppUserModelID (for example [code]MyCompany.MyGame[/code]). When [param create_shortcut] is [code]true[/code], WinToast creates or updates a Start Menu shortcut for the AppUserModelID, which some Windows versions require for toasts to appear. Returns [code]true[/code] on success. Calling this more than once is a no-op.
			</description>
		</method>
		<method name="is_available" qualifiers="static">
			<return type="bool" />
			<description>
				Returns [code]true[/code] if the current Windows version supports toast notifications.
			</description>
		</method>
		<method name="is_initialized" qualifiers="const">
			<return type="bool" />
			<description>
				Returns [code]true[/code] if [method initialize] succeeded.
			</description>
		</method>
		<method name="show_toast">
			<return type="int" />
			<param index="0" name="title" type="String" />
			<param index="1" name="message" type="String" />
			<param index="2" name="options" type="ToastOptions" default="null" />
			<description>
				Shows a two-line toast and returns its id, or [code]-1[/code] on failure. Icon, duration, sound, image crop and replace behaviour are configured through a [ToastOptions] object; pass [code]null[/code] to use the defaults.
			</description>
		</method>
	</methods>
	<signals>
		<signal name="toast_activated">
			<param index="0" name="toast_id" type="int" />
			<description>
				Emitted when the user activates (clicks) a toast. This is always emitted on the main thread.
			</description>
		</signal>
		<signal name="toast_failed">
			<param index="0" name="toast_id" type="int" />
			<description>
				Emitted when Windows reports that the toast could not be displayed, for example because its content or audio URI was invalid.
			</description>
		</signal>
		<signal name="toast_shown">
			<param index="0" name="toast_id" type="int" />
			<description>
				Emitted after a toast was successfully handed to Windows, with the id returned by [method show_toast].
			</description>
		</signal>
	</signals>
	<constants>
		<constant name="TOAST_DURATION_SYSTEM" value="0" enum="ToastDuration">
			Use the system default toast duration.
		</constant>
		<constant name="TOAST_DURATION_SHORT" value="1" enum="ToastDuration">
			Short duration (about 7 seconds).
		</constant>
		<constant name="TOAST_DURATION_LONG" value="2" enum="ToastDuration">
			Long duration (about 25 seconds).
		</constant>
		<constant name="TOAST_AUDIO_DEFAULT" value="0" enum="ToastAudioOption">
			Play the selected toast sound once.
		</constant>
		<constant name="TOAST_AUDIO_SILENT" value="1" enum="ToastAudioOption">
			Show the toast without any sound.
		</constant>
		<constant name="TOAST_AUDIO_LOOP" value="2" enum="ToastAudioOption">
